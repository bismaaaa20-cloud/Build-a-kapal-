-- 2. Fungsi otomatis untuk melacak dan memicu tombol "Save" pada UI menu
local function triggerSaveButton(parent)
    for _, child in ipairs(parent:GetChildren()) do
        -- Mencari elemen tombol dengan teks "Save"
        if child:IsA("TextButton") then
            local txt = string.lower(child.Text)
            if string.find(txt, "save") and not string.find(txt, "auto") then
                return child
            end
        elseif child:IsA("TextLabel") then
            local txt = string.lower(child.Text)
            if string.find(txt, "save") and not string.find(txt, "auto") then
                -- Jika teks berada di dalam label, tombol aslinya adalah parent dari label ini
                if child.Parent:IsA("TextButton") or child.Parent:IsA("GuiButton") then
                    return child.Parent
                end
            end
        end
        
        -- Cari lebih dalam ke sub-frame menu
        local found = triggerSaveButton(child)
        if found then return found end
    end
    return nil
end

-- 3. Loop Otomatis di Latar Belakang (Berjalan setiap 60 detik)
task.spawn(function()
    -- Beri jeda 10 detik di awal agar menu utama selesai terbuka sempurna di layar HP Anda
    task.wait(10)
    
    local PlayerGui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
    print("[Auto-Save] Sistem pelacak tombol Save aktif di latar belakang!")
    
    while task.wait(60) do
        local saveButton = nil
        
        -- Memindai UI eksternal di PlayerGui ponsel Anda
        for _, gui in ipairs(PlayerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Name ~= "Chat" and gui.Name ~= "RobloxGui" then
                saveButton = triggerSaveButton(gui)
                if saveButton then break end
            end
        end
        
        -- Jika tombol save terdeteksi, lakukan klik otomatis tanpa mengganggu permainan
        if saveButton then
            if firesignal then
                firesignal(saveButton.MouseButton1Click)
            elseif buttonactivate then
                buttonactivate(saveButton)
            else
                -- Metode cadangan untuk executor HP berspesifikasi rendah
                local connections = getconnections(saveButton.MouseButton1Click)
                for _, connection in ipairs(connections) do
                    connection:Fire()
                end
            end
            print("[Auto-Save] Berhasil menyimpan progres otomatis!")
        end
    end
end)
