-- ====================================================================
-- INSTAN AUTO SAVE (TANPA JEDA / INSTANT TRIGGER)
-- ====================================================================

-- 1. Jalankan langsung skrip utama Anda
pcall(function()
    loadstring(game:HttpGet('https://githubusercontent.com'))()
end)

-- 2. Fungsi pemindaian tombol Save secara agresif
local function forceClickSave(parent)
    for _, child in ipairs(parent:GetChildren()) do
        -- Cari teks tombol dengan kata "save"
        if child:IsA("TextButton") then
            local txt = string.lower(child.Text)
            if string.find(txt, "save") and not string.find(txt, "auto") then
                return child
            end
        elseif child:IsA("TextLabel") then
            local txt = string.lower(child.Text)
            if string.find(txt, "save") and not string.find(txt, "auto") then
                if child.Parent:IsA("TextButton") or child.Parent:IsA("GuiButton") then
                    return child.Parent
                end
            end
        end
        local found = forceClickSave(child)
        if found then return found end
    end
    return nil
end

-- 3. Loop Instan: Berjalan tanpa jeda awal dan klik setiap 1 detik
task.spawn(function()
    local PlayerGui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
    
    while task.wait(1) do -- Memaksa sistem menekan tombol Save setiap 1 detik
        local saveButton = nil
        
        -- Pindai seluruh UI di layar HP
        for _, gui in ipairs(PlayerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Name ~= "Chat" and gui.Name ~= "RobloxGui" then
                saveButton = forceClickSave(gui)
                if saveButton then break end
            end
        end
        
        -- Langsung tembak klik instan jika tombolnya muncul di layar
        if saveButton then
            if firesignal then
                firesignal(saveButton.MouseButton1Click)
            elseif buttonactivate then
                buttonactivate(saveButton)
            else
                local connections = getconnections(saveButton.MouseButton1Click)
                for _, connection in ipairs(connections) do
                    connection:Fire()
                end
            end
        end
    end
end)
